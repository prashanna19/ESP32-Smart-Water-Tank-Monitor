[
  {
    "id": "wtp_tab",
    "type": "tab",
    "label": "Water Tank Live + Prediction",
    "disabled": false,
    "info": "ESP32 + HC-SR04. Tank height is configured as 27 cm."
  },
  {
    "id": "wtp_mqtt",
    "type": "mqtt in",
    "z": "wtp_tab",
    "name": "ESP32 water/data",
    "topic": "water/data",
    "qos": "0",
    "datatype": "auto",
    "broker": "wtp_broker",
    "nl": false,
    "rap": true,
    "rh": 0,
    "inputs": 0,
    "x": 160,
    "y": 120,
